# CALMER — environment variables. Copy to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys — especially the service-role key.

# ── Supabase (all features) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Where the sign-up confirmation email sends the user back to.
# Falls back to the current origin, so only set this if you need to override
# it (e.g. testing against a deployed instance from localhost).
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Server-only. Bypasses RLS — used by the hardware ingest route + service client.
# NEVER expose as NEXT_PUBLIC_*, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ───────────────────────────────────────────────────────────────────
# Therapist chat: Llama-3.3-70B via Groq (free, fast, no licence gate, no credits).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Sentiment classifier (j-hartmann). Currently calls the HF Inference router;
# a free HF *read* token is enough (NO gated licence needed for this small
# model). Leave blank to fall back to the lexicon stub. Being migrated to a
# self-hosted transformers.js model, after which this becomes unnecessary.
HF_TOKEN=

# Optional: override the chat model without code changes (must be a Groq model id).
# CALMER_CHAT_MODEL=llama-3.3-70b-versatile

# ── Hardware (Arduino → serial-bridge → /api/biometric) ───────────────────
# Shared secret gating the biometric ingest route; must equal the bridge's value.
HARDWARE_INGEST_SECRET=
# Used by hardware/serial-bridge.js (not the Next.js build):
# CALMER_API_URL=http://localhost:3000
