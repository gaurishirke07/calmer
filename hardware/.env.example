# CALMER hardware bridge/simulator config.
# Copy to hardware/.env (gitignored) and fill in. These must match the web app.

# Where the running Next.js app is:
CALMER_API_URL=http://localhost:3000

# Shared secret gating /api/biometric — must EQUAL HARDWARE_INGEST_SECRET
# in the app's root .env.local:
CALMER_HARDWARE_SECRET=

# Optional defaults (otherwise pass --port / --session on the command line):
# CALMER_SERIAL_PORT=COM5
# CALMER_SESSION_ID=

# Identifies the board so its rows are distinguishable from simulated ones.
# The bridge sends this; the ingest route registers a hardware_device row and
# stamps biometric_reading.device_id with it. simulate.js never sends one, so
# simulated rows keep device_id = null. Keep the label STABLE across runs or
# you will accumulate duplicate device rows.
# Overridable per run with --device-label. Defaults to arduino-uno-01.
# CALMER_DEVICE_LABEL=arduino-uno
